<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>Fafp.Templates.Console.Minimal</PackageId>
    <PackageVersion>1.0.1</PackageVersion>
    <Title>FAF Console Minimal Template</Title>
    <Authors>Firefly AI Flow Platform</Authors>
    <Description>Minimal console boilerplate for hypothesis testing.</Description>
    <PackageTags>dotnet-new;templates;console;faf</PackageTags>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>icon_128x128.png</PackageIcon>
    <Copyright>© 2026 Firefly AI Flow Platform</Copyright>
  </PropertyGroup>

<ItemGroup>
  <Content Include="**\*"
           Exclude="**\bin\**;**\obj\**;*.template.csproj;.template.config\**;icon_128x128.png"
           PackagePath="content" />
  <Content Include=".template.config\**"
           PackagePath="content\.template.config" />
  <None Include="README.md" Pack="true" PackagePath="\" />
  <None Include="icon_128x128.png" Pack="true" PackagePath="\" />
</ItemGroup>

</Project>